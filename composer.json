{
    "name": "joelseneque/help-requests",
    "description": "A Filament v5 help desk: a floating in-app help widget, an admin triage resource, email + database notifications, and optional two-way GitHub issue sync via a GitHub App.",
    "keywords": [
        "filament",
        "laravel",
        "livewire",
        "help-desk",
        "support",
        "github"
    ],
    "homepage": "https://github.com/joelseneque/help-requests",
    "license": "MIT",
    "authors": [
        {
            "name": "Joel Seneque",
            "email": "joel@coll.group",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Joelseneque\\HelpRequests\\": "src/",
            "Joelseneque\\HelpRequests\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joelseneque\\HelpRequests\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Joelseneque\\HelpRequests\\HelpRequestsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "ignore": {
                "PKSA-ndkp-2znf-9m7c": "Dev dependency advisory; the consuming app pins its own Filament version."
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
